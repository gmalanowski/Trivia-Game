generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// 0 EXP      BEGINNER
// 1,000 EXP  TRAINEE
// 2,000 EXP  NOVICE
// 3,000 EXP  ROOKIE
// 4,000 EXP  AMATEUR
// 5,000 EXP  APPRENTICE
// 6,000 EXP  INTERMEDIATE
// 7,000 EXP  COMPETENT
// 8,000 EXP  PROFICIENT
// 9,000 EXP  EXPERIENCED
// 10,000 EXP ADVANCED
// 11,000 EXP SPECIALIST
// 12,000 EXP PROFESSIONAL
// 13,000 EXP EXPERT
// 14,000 EXP VETERAN
// 15,000 EXP ELITE
// 16,000 EXP MASTER
// 17,000 EXP GRANDMASTER
// 18,000 EXP CHAMPION
// 19,000 EXP LEGEND
// 20,000 EXP PINNACLE

enum Title {
  BEGINNER
  TRAINEE
  NOVICE
  ROOKIE
  AMATEUR
  APPRENTICE
  INTERMEDIATE
  COMPETENT
  PROFICIENT
  EXPERIENCED
  ADVANCED
  SPECIALIST
  PROFESSIONAL
  EXPERT
  VETERAN
  ELITE
  MASTER
  GRANDMASTER
  CHAMPION
  LEGEND
  PINNACLE
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String?

  bio       String?
  avatarUrl String?
  title     Title   @default(BEGINNER)
  exp       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions QuizSession[]
}

model QuizSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         SessionStatus @default(IN_PROGRESS)
  score          Int           @default(0)
  totalQuestions Int
  category       String?
  difficulty     Difficulty?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  results QuizResult[]

  @@index([userId])
}

model QuizResult {
  id        String      @id @default(uuid())
  sessionId String
  session   QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionText  String
  userAnswer    String?
  correctAnswer String
  isCorrect     Boolean

  createdAt DateTime @default(now())

  @@index([sessionId])
}
