    console.log(`✅ Created user: ${createdUser.username} (EXP: ${createdUser.exp}, Sessions: ${u.sessions.length})`);
  }

  console.log("🎉 Seeding completed successfully!");
}

main()
  .catch((e) => {
    console.error("❌ Seeding failed:");
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
