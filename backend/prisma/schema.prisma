generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Title {
  BEGINNER // 0 EXP 
  TRAINEE // 1,000 EXP 
  NOVICE // 2,000 EXP
  ROOKIE // 3,000 EXP 
  AMATEUR // 4,000 EXP 
  APPRENTICE // 5,000 EXP 
  INTERMEDIATE // 6,000 EXP 
  COMPETENT // 7,000 EXP
  PROFICIENT // 8,000 EXP 
  EXPERIENCED // 9,000 EXP 
  ADVANCED // 10,000 EXP
  SPECIALIST // 11,000 EXP
  PROFESSIONAL // 12,000 EXP
  EXPERT // 13,000 EXP
  VETERAN // 14,000 EXP
  ELITE // 15,000 EXP
  MASTER // 16,000 EXP
  GRANDMASTER // 17,000 EXP
  CHAMPION // 18,000 EXP 
  LEGEND // 19,000 EXP
  PINNACLE // 20,000 EXP 
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  username     String  @unique
  passwordHash String?

  bio       String?
  avatarUrl String?
  title     Title   @default(BEGINNER)
  exp       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions QuizSession[]
}

model QuizSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status         SessionStatus @default(IN_PROGRESS)
  score          Int           @default(0)
  totalQuestions Int
  category       String?
  difficulty     Difficulty?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  results QuizResult[]

  @@index([userId])
}

model QuizResult {
  id        String      @id @default(uuid())
  sessionId String
  session   QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionText  String
  userAnswer    String?
  correctAnswer String
  isCorrect     Boolean

  createdAt DateTime @default(now())

  @@index([sessionId])
}
